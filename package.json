{
  "name": "duel-80-20-prototype",
  "private": true,
  "version": "1.1.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "export:policy": "set PYTHONPATH=src&& python -m duel_solver export-runtime-policy --output public/policies",
    "verify:policy": "set PYTHONPATH=src&& python -m duel_solver verify-runtime-policy public/policies/80_20_difficult.policy.json",
    "smoke:fuzz": "vitest run web/bot/smoke.test.ts && node scripts/smoke-fuzz.mjs",
    "verify:prototype": "node scripts/verify-prototype.mjs",
    "complete:prototype": "npm run export:policy && npm run verify:policy && npm run test && npm run typecheck && npm run lint && npm run build && npm run smoke:fuzz && npm run verify:prototype",
    "ralph:prototype": "powershell -ExecutionPolicy Bypass -File scripts/ralph-loop.ps1",
    "serve:api": "php -S 127.0.0.1:8088 -t public",
    "db:migrate": "php server/bin/migrate.php",
    "test:php": "php server/tests/run.php",
    "package:v1": "npm run build && node scripts/package-v1.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "flag-icons": "^7.5.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "jsdom": "^29.1.1",
    "vitest": "latest"
  }
}
